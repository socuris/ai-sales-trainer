.container { padding: 30rpx; background: #f5f5f5; min-height: 100vh; }
.start, .quiz, .result { background: #fff; border-radius: 16rpx; padding: 30rpx; }
.title { font-size: 36rpx; font-weight: bold; margin-bottom: 20rpx; }
.point { color: #999; margin-bottom: 30rpx; }
textarea { width: 100%; height: 200rpx; border: 1rpx solid #eee; border-radius: 8rpx; padding: 20rpx; box-sizing: border-box; }
button { background: #0066FF; color: #fff; margin-top: 20rpx; }
.score { font-size: 48rpx; font-weight: bold; color: #0066FF; text-align: center; margin-bottom: 30rpx; }
.label { font-weight: bold; margin: 20rpx 0 10rpx; }
