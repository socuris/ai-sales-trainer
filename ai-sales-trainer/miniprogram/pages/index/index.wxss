.container { padding: 30rpx; background: #f5f5f5; min-height: 100vh; }
.header { margin-bottom: 40rpx; }
.greeting { font-size: 48rpx; font-weight: bold; }
.subtitle { color: #999; }
.actions { display: flex; justify-content: space-between; }
.action { width: 200rpx; height: 180rpx; background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 20rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; }
.action .icon { font-size: 60rpx; margin-bottom: 10rpx; }
