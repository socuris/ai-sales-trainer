.container { padding: 30rpx; background: #f5f5f5; min-height: 100vh; }
.input-box { background: #fff; border-radius: 16rpx; padding: 30rpx; }
.input-box textarea { width: 100%; height: 200rpx; border: 1rpx solid #eee; border-radius: 8rpx; padding: 20rpx; box-sizing: border-box; }
.input-box button { background: #0066FF; color: #fff; margin-top: 20rpx; }
.answer { margin-top: 30rpx; background: #fff; border-radius: 16rpx; padding: 30rpx; }
.label { color: #0066FF; font-weight: bold; margin: 20rpx 0 10rpx; }
.text { color: #333; line-height: 1.6; }
